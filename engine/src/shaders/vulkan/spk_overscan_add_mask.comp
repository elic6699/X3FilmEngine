// Faithful line-by-line transcription of overscan.metal's spk_overscan_add_mask
// kernel. This kernel references no enum constants and calls no helpers (every
// M index is a literal), so none are duplicated into this file.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Mask { float mask[]; };
layout(std430, binding = 1) readonly buffer Mpar { float M[]; };
layout(std430, binding = 2) readonly buffer Cnt  { uint  n[]; };
layout(std430, binding = 3) buffer          Can  { float canvas[]; };

// vulkan_gpu.cpp folds a dispatch past maxComputeWorkGroupCount[0] (65535 on
// lavapipe and Intel) into rows of workgroups; this is the 1D index it means.
uint spk_global_index() {
    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

// (3): a rasterised imprint (coverage, canvas-aligned) added as exposure.
// M = {x0, y0, mw, mh, cw, ch, e_r, e_g, e_b}.
void main() {
    uint i = spk_global_index();
    if (i >= n[0]) return;
    const uint mw = uint(M[2]);
    const int x = int(M[0]) + int(i % mw), y = int(M[1]) + int(i / mw);
    if (x < 0 || y < 0 || x >= int(M[4]) || y >= int(M[5])) return;
    const float c = mask[i];
    if (c <= 0.0f) return;
    const uint o = 3u * (uint(y) * uint(M[4]) + uint(x));
    canvas[o] += c * M[6];
    canvas[o + 1u] += c * M[7];
    canvas[o + 2u] += c * M[8];
}
