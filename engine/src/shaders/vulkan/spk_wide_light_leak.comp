// Faithful line-by-line transcription of overscan.metal's spk_wide_light_leak
// kernel (:732-813) and every helper it reaches.
//
// Transitive closure of the helpers actually used by this kernel:
//   canvas_to_film (:48-52), hash_u/hash_f/value_noise (:54-63),
//   perf_sdf (:410-461), kHoleEdgeSigma (:471), erf_as (:474-478),
//   film_alpha (:481-496), wide_sample/wide_matrix/wide_encode/wide_decode
//   (:712-731).
// film_alpha only reaches perf_sdf -> hash_u/hash_f/value_noise and erf_as;
// gate_sdf (:91-126) / sd_quad (:67-81) are NOT in this closure and are not
// transcribed (they are used by scratch_mask/dust_mask/exposure_gate_sdf).
//
// TWO DISTINCT PARAMETER BLOCKS -- do not mix them:
//   * binding 1 `P[]`  : this kernel's OWN float[37] parameter block. The
//     kernel body indexes it with LITERAL indices P[0]..P[36] and the CAT02
//     matrices P+13 / P+22. These literals are NOT the OsP enum values.
//     wide_matrix() reads P[] (its device pointer was P+13 / P+22).
//   * binding 3 `G[]`  : overscan's P_COUNT=277 geometry block (the `geometry`
//     argument at :743). canvas_to_film / perf_sdf / film_alpha read G[] via
//     the OsP enum constants. In the Metal source these helpers took a
//     `device const float* P` that was the 277-float block; here that pointer
//     becomes G[].
//
// Metal binding 2 is `device const ushort*` -- a uint16_t[w*h*3] RGB16 texture
// uploaded raw. std430 has no 16-bit scalar, so it is declared uint[] and read
// little-endian halfword-by-halfword through tex_u16(). wide_sample keeps the
// source's own / 65535.0f normalisation (float(ushort) -> [0,1]).
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Rgb      { float rgb[]; };
layout(std430, binding = 1) readonly buffer Par      { float P[]; };
layout(std430, binding = 2) readonly buffer Tex      { uint tex[]; };
layout(std430, binding = 3) readonly buffer Geometry { float G[]; };
layout(std430, binding = 4) buffer Out               { float outp[]; };

// vulkan_gpu.cpp folds a dispatch past maxComputeWorkGroupCount[0] (65535 on
// lavapipe and Intel) into rows of workgroups; this is the 1D index it means.
uint spk_global_index() {
    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

